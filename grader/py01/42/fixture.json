"ttl\"])\n                    value[\"n\"].append(\"caller mutation\")\n                elif operation[\"op\"] == \"get\":\n                    self.assertEqual(cache.get(operation[\"key\"]), operation[\"expected\"])\n                else:\n                    self.assertEqual(len(cache), operation[\"expected\"])\n\n\nif __name__ == '__main__':\n    unittest.main()\n"
